# Cargar estos valores como variables del proyecto en Docker Manager.
# Usar SHA completo de un commit publicado y aprobado, no una rama mutable.
PIGAR_DEPLOY_REF=REEMPLAZAR_CON_SHA_COMPLETO_APROBADO
PIGAR_STAGING_FQDN=pigar.ferchamorro.cloud
PIGAR_POSTGRES_DB=pigar_staging
PIGAR_POSTGRES_USER=pigar_staging
PIGAR_POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_ALEATORIO_URL_SAFE
PIGAR_DATABASE_URL=postgresql://pigar_staging:REEMPLAZAR_CON_SECRETO_ALEATORIO_URL_SAFE@postgres:5432/pigar_staging?schema=public
