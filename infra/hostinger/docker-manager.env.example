# Cargar estos valores como variables del proyecto en Docker Manager.
# El commit se fija en la URL raw del Compose; no usar una rama mutable.
# La primera creación inicia sólo bootstrap. Agregar también COMPOSE_PROFILES=app
# y usar Update después de cargar los valores de abajo.
COMPOSE_PROFILES=app
# SHA completo de una imagen publicada por el workflow publish-staging-images.
PIGAR_IMAGE_TAG=REEMPLAZAR_CON_SHA_PUBLICADO_EN_GHCR
PIGAR_STAGING_FQDN=pigar.ferchamorro.cloud
PIGAR_POSTGRES_DB=pigar_staging
PIGAR_POSTGRES_USER=pigar_staging
PIGAR_POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_ALEATORIO_URL_SAFE
PIGAR_DATABASE_URL=postgresql://pigar_staging:REEMPLAZAR_CON_SECRETO_ALEATORIO_URL_SAFE@postgres:5432/pigar_staging?schema=public
# Auth0 staging: tomar valores del gestor seguro, nunca de Git ni del chat.
PIGAR_API_AUTH0_ISSUER=https://REEMPLAZAR_TENANT_AUTH0/
PIGAR_API_AUTH0_AUDIENCE=https://REEMPLAZAR_AUDIENCE_API
PIGAR_API_AUTH0_ADMIN_CLIENT_ID=REEMPLAZAR_CLIENT_ID_ADMIN
PIGAR_API_AUTH0_MANAGEMENT_CLIENT_ID=REEMPLAZAR_CLIENT_ID_MANAGEMENT
PIGAR_API_AUTH0_MANAGEMENT_CLIENT_SECRET=REEMPLAZAR_SECRETO_MANAGEMENT
PIGAR_API_AUTH0_INTERNAL_CONNECTION=REEMPLAZAR_CONEXION_BASE_DE_DATOS_INTERNA
PIGAR_CUSTOMER_AUTH0_DOMAIN=REEMPLAZAR_TENANT_AUTH0
PIGAR_CUSTOMER_AUTH0_CLIENT_ID=REEMPLAZAR_CLIENT_ID_CLIENTE
PIGAR_CUSTOMER_AUTH0_CLIENT_SECRET=REEMPLAZAR_SECRETO_CLIENTE
PIGAR_CUSTOMER_AUTH0_APP_BASE_URL=https://pigar.ferchamorro.cloud
PIGAR_CUSTOMER_AUTH0_AUDIENCE=https://REEMPLAZAR_AUDIENCE_API
PIGAR_CUSTOMER_AUTH0_SESSION_SECRET=REEMPLAZAR_SECRETO_SESION_URL_SAFE
PIGAR_CUSTOMER_AUTH0_EMAIL_OTP_CONNECTION=REEMPLAZAR_CONEXION_OTP_EMAIL
PIGAR_ADMIN_AUTH0_DOMAIN=REEMPLAZAR_TENANT_AUTH0
PIGAR_ADMIN_AUTH0_CLIENT_ID=REEMPLAZAR_CLIENT_ID_ADMIN
PIGAR_ADMIN_AUTH0_CLIENT_SECRET=REEMPLAZAR_SECRETO_ADMIN
PIGAR_ADMIN_AUTH0_APP_BASE_URL=https://pigar.ferchamorro.cloud
PIGAR_ADMIN_AUTH0_AUDIENCE=https://REEMPLAZAR_AUDIENCE_API
PIGAR_ADMIN_AUTH0_SESSION_SECRET=REEMPLAZAR_SECRETO_SESION_URL_SAFE
