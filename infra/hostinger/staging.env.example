# Copiar fuera del repositorio, por ejemplo a /etc/pigar/staging.env.
# No versionar el archivo real ni usar valores de producción.
NODE_ENV=production
PIGAR_HTTP_BIND=127.0.0.1
PIGAR_HTTP_PORT=8088
PIGAR_POSTGRES_DB=pigar_staging
PIGAR_POSTGRES_USER=pigar_staging
PIGAR_POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_ALEATORIO_URL_SAFE
PIGAR_DATABASE_URL=postgresql://pigar_staging:REEMPLAZAR_CON_SECRETO_ALEATORIO_URL_SAFE@postgres:5432/pigar_staging?schema=public
# Auth0 no productivo: usar los valores del tenant de staging, fuera de Git.
# API y aplicaciones web se mantienen separados para no mezclar clientes OIDC.
PIGAR_API_AUTH0_ISSUER=https://REEMPLAZAR_TENANT_AUTH0/
PIGAR_API_AUTH0_AUDIENCE=https://REEMPLAZAR_AUDIENCE_API
PIGAR_API_AUTH0_ADMIN_CLIENT_ID=REEMPLAZAR_CLIENT_ID_ADMIN
PIGAR_API_AUTH0_MANAGEMENT_CLIENT_ID=REEMPLAZAR_CLIENT_ID_MANAGEMENT
PIGAR_API_AUTH0_MANAGEMENT_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_AUTH0_NO_PRODUCTIVO
PIGAR_API_AUTH0_INTERNAL_CONNECTION=REEMPLAZAR_CONEXION_BASE_DE_DATOS_INTERNA
PIGAR_CUSTOMER_AUTH0_DOMAIN=REEMPLAZAR_TENANT_AUTH0
PIGAR_CUSTOMER_AUTH0_CLIENT_ID=REEMPLAZAR_CLIENT_ID_CLIENTE
PIGAR_CUSTOMER_AUTH0_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_CLIENTE_NO_PRODUCTIVO
PIGAR_CUSTOMER_AUTH0_APP_BASE_URL=https://REEMPLAZAR_FQDN_STAGING
PIGAR_CUSTOMER_AUTH0_AUDIENCE=https://REEMPLAZAR_AUDIENCE_API
PIGAR_CUSTOMER_AUTH0_SESSION_SECRET=REEMPLAZAR_CON_SECRETO_SESION_ALEATORIO
PIGAR_CUSTOMER_AUTH0_GOOGLE_CONNECTION=REEMPLAZAR_CONEXION_GOOGLE
PIGAR_CUSTOMER_AUTH0_EMAIL_OTP_CONNECTION=REEMPLAZAR_CONEXION_OTP_EMAIL
PIGAR_ADMIN_AUTH0_DOMAIN=REEMPLAZAR_TENANT_AUTH0
PIGAR_ADMIN_AUTH0_CLIENT_ID=REEMPLAZAR_CLIENT_ID_ADMIN
PIGAR_ADMIN_AUTH0_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_ADMIN_NO_PRODUCTIVO
PIGAR_ADMIN_AUTH0_APP_BASE_URL=https://REEMPLAZAR_FQDN_STAGING
PIGAR_ADMIN_AUTH0_AUDIENCE=https://REEMPLAZAR_AUDIENCE_API
PIGAR_ADMIN_AUTH0_SESSION_SECRET=REEMPLAZAR_CON_SECRETO_SESION_ALEATORIO
