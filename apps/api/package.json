{
  "name": "@pigar/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "start:local": "node --env-file=../../.env dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-fastify": "^11.1.11",
    "@pigar/config": "workspace:*",
    "@pigar/contracts": "workspace:*",
    "@pigar/observability": "workspace:*",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "fastify": "^5.6.1",
    "jose": "6.1.3",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.0"
  }
}
