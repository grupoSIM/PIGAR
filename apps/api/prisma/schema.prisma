generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProcessingState {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ValidationState {
  RECEIVED
  VALID
  INVALID
}

enum MediaPocState {
  PENDING
  AVAILABLE
  REJECTED
  EXPIRED
  DELETED
}

enum ProfileRole {
  CLIENT
  DISPATCHER
  ADMIN
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
}

enum CatalogPublicationStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CoverageZoneStatus {
  ACTIVE
  INACTIVE
}

enum RequestCompleteness {
  MEDIA_REQUIRED
  READY_FOR_OPERATION
}

enum RequestMediaKind {
  IMAGE
  VIDEO
}

enum TechnicianStatus {
  ACTIVE
  INACTIVE
}

enum WorkOrderState {
  SOLICITADA
  TECNICO_ASIGNADO
  EN_CAMINO
  EN_ATENCION
  TRABAJO_FINALIZADO
  PENDIENTE_PAGO
  PENDIENTE_CONFORMIDAD
  CERRADA
  CANCELADA
}

enum PaymentAttemptState {
  CREATED
  UNKNOWN
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChargeResolutionOutcome {
  RESUELTO_EN_VISITA
  REQUIERE_PRESUPUESTO
}

enum RatingReason {
  CALIDAD_DEL_TRABAJO
  PUNTUALIDAD
  TRATO_Y_COMUNICACION
  CLARIDAD_DEL_PROCESO
  EXPERIENCIA_GENERAL
  OTRO
}

enum AftercareIncidentType {
  RESULTADO_NO_ESPERADO
  PROBLEMA_REAPARECIO
  TRABAJO_INCOMPLETO
  DANIO_REPORTADO
  CONSULTA_SOBRE_COBRO
}

enum AftercareIncidentStatus {
  ABIERTA
  EN_TRIAGE
  CERRADA
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  eventType String @db.VarChar(100)
  version Int
  aggregateType String? @db.VarChar(60)
  aggregateId String? @db.VarChar(100)
  payload Json?
  state ProcessingState @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  notifications TransactionalNotification[]
  @@index([state, availableAt])
  @@map("outbox_event")
}

model ClaimedJob {
  id String @id @default(uuid()) @db.Uuid
  jobType String @db.VarChar(100)
  idempotencyKey String @db.VarChar(160)
  state ProcessingState @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  lastSafeError String? @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([jobType, idempotencyKey])
  @@index([state, availableAt])
  @@map("claimed_job")
}

model ProviderEventReceipt {
  id String @id @default(uuid()) @db.Uuid
  provider String @db.VarChar(60)
  externalEventIdHash String @db.VarChar(128)
  eventType String @db.VarChar(100)
  validationState ValidationState @default(RECEIVED)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  validatedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([provider, externalEventIdHash])
  @@index([validationState, receivedAt])
  @@map("provider_event_receipt")
}

model MediaPocObject {
  id String @id @default(uuid()) @db.Uuid
  physicalName String @unique @db.VarChar(180)
  detectedMime String @db.VarChar(120)
  bytes BigInt
  checksum String @db.VarChar(128)
  state MediaPocState @default(PENDING)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([state, expiresAt])
  @@map("media_poc_object")
}

model Profile {
  id String @id @default(uuid()) @db.Uuid
  identitySubject String @unique @db.VarChar(255)
  role ProfileRole
  status ProfileStatus @default(ACTIVE)
  displayName String? @db.VarChar(120)
  phone String? @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  requests ServiceRequest[]
  orderTransitions WorkOrderTransition[]
  assignmentCommands AssignmentIdempotency[]
  resolutionCommands ResolutionCommand[]
  conformities Conformity[]
  notifications TransactionalNotification[]
  ratings OrderRating[]
  aftercareIncidents AftercareIncident[]
  aftercareIncidentTransitions AftercareIncidentTransition[]
  @@index([role, status])
  @@map("profile")
}

model ServiceRequest {
  id String @id @default(uuid()) @db.Uuid
  clientProfileId String @db.Uuid
  idempotencyKey String @db.VarChar(160)
  description String @db.VarChar(2000)
  completeness RequestCompleteness @default(MEDIA_REQUIRED)
  categoryId String @db.Uuid
  categoryName String @db.VarChar(120)
  categoryScope String @db.VarChar(1000)
  zoneId String @db.Uuid
  zoneName String @db.VarChar(120)
  currency String @db.Char(3)
  amount Decimal @db.Decimal(12,2)
  rateVersion Int
  rateValidFrom DateTime @db.Timestamptz(3)
  rateValidUntil DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  client Profile @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  address RequestAddress?
  media RequestMedia[]
  workOrder WorkOrder?
  notifications TransactionalNotification[]
  @@unique([clientProfileId, idempotencyKey])
  @@index([clientProfileId, createdAt])
  @@map("service_request")
}

model TransactionalNotification {
  id String @id @default(uuid()) @db.Uuid
  recipientProfileId String @db.Uuid
  sourceEventId String @db.Uuid
  requestId String @db.Uuid
  eventType String @db.VarChar(100)
  templateKey String @db.VarChar(80)
  templateVersion Int
  readAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  recipient Profile @relation(fields: [recipientProfileId], references: [id], onDelete: Restrict)
  sourceEvent OutboxEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@unique([sourceEventId, recipientProfileId])
  @@index([recipientProfileId, createdAt, id])
  @@index([recipientProfileId, readAt])
  @@map("transactional_notification")
}

model Technician {
  id String @id @default(uuid()) @db.Uuid
  fullName String @db.VarChar(160)
  phone String? @db.VarChar(32)
  status TechnicianStatus @default(INACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  workOrders WorkOrder[]
  transitions WorkOrderTransition[]
  @@index([status])
  @@map("technician")
}

model WorkOrder {
  id String @id @default(uuid()) @db.Uuid
  requestId String @unique @db.Uuid
  technicianId String? @db.Uuid
  state WorkOrderState @default(SOLICITADA)
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  transitions WorkOrderTransition[]
  assignmentCommands AssignmentIdempotency[]
  resolution Resolution?
  charge Charge?
  rating OrderRating?
  aftercareIncidents AftercareIncident[]
  @@index([state, updatedAt])
  @@map("work_order")
}

model OrderRating {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @unique @db.Uuid
  clientProfileId String @db.Uuid
  stars Int @db.SmallInt
  reason RatingReason
  otherMessage String? @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  client Profile @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  @@index([clientProfileId, createdAt, id])
  @@map("order_rating")
}

model AftercareIncident {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @db.Uuid
  clientProfileId String @db.Uuid
  type AftercareIncidentType
  status AftercareIncidentStatus @default(ABIERTA)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  client Profile @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  transitions AftercareIncidentTransition[]
  @@unique([id, version])
  @@index([clientProfileId, createdAt, id])
  @@index([status, updatedAt, id])
  @@map("aftercare_incident")
}

model AftercareIncidentTransition {
  id String @id @default(uuid()) @db.Uuid
  incidentId String @db.Uuid
  sequence Int
  action String @db.VarChar(30)
  fromStatus AftercareIncidentStatus?
  toStatus AftercareIncidentStatus
  actorProfileId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  incident AftercareIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  @@unique([incidentId, sequence])
  @@index([incidentId, sequence])
  @@map("aftercare_incident_transition")
}

model AftercareIdempotency {
  id String @id @default(uuid()) @db.Uuid
  actorProfileId String @db.Uuid
  scope String @db.VarChar(40)
  idempotencyKey String @db.VarChar(160)
  payloadHash String @db.Char(64)
  resultId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([actorProfileId, scope, idempotencyKey])
  @@map("aftercare_idempotency")
}

model Resolution {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @unique @db.Uuid
  outcome ChargeResolutionOutcome
  summary String @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  command ResolutionCommand?
  @@map("resolution")
}

model ResolutionCommand {
  id String @id @default(uuid()) @db.Uuid
  actorProfileId String @db.Uuid
  idempotencyKey String @db.VarChar(160)
  workOrderId String @db.Uuid
  payloadHash String @db.Char(64)
  resolutionId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  resolution Resolution? @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  @@unique([actorProfileId, idempotencyKey])
  @@map("resolution_command")
}

model Charge {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @unique @db.Uuid
  categoryName String @db.VarChar(120)
  offerVersion Int
  currency String @db.Char(3)
  amount Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]
  conformity Conformity?
  @@map("charge")
}

model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  chargeId String @db.Uuid
  externalReference String @unique @db.VarChar(100)
  checkoutUrl String? @db.VarChar(2048)
  providerPaymentIdHash String? @db.Char(64)
  state PaymentAttemptState @default(CREATED)
  sequence Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  checkedAt DateTime? @db.Timestamptz(3)
  charge Charge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  @@unique([chargeId, sequence])
  @@index([state, checkedAt])
  @@map("payment_attempt")
}

model Conformity {
  id String @id @default(uuid()) @db.Uuid
  chargeId String @unique @db.Uuid
  clientProfileId String @db.Uuid
  textVersion String @db.VarChar(60)
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)
  charge Charge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  client Profile @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  @@map("conformity")
}

model WorkOrderTransition {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @db.Uuid
  actorProfileId String? @db.Uuid
  technicianId String? @db.Uuid
  action String @db.VarChar(60)
  fromState WorkOrderState
  toState WorkOrderState
  reason String? @db.VarChar(500)
  version Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor Profile? @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  @@unique([workOrderId, version])
  @@index([workOrderId, createdAt])
  @@map("work_order_transition")
}

model AssignmentIdempotency {
  id String @id @default(uuid()) @db.Uuid
  actorProfileId String @db.Uuid
  idempotencyKey String @db.VarChar(160)
  requestId String @db.Uuid
  technicianId String @db.Uuid
  workOrderId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  @@unique([actorProfileId, idempotencyKey])
  @@index([requestId])
  @@map("assignment_idempotency")
}

model RequestAddress {
  id String @id @default(uuid()) @db.Uuid
  requestId String @unique @db.Uuid
  street String @db.VarChar(160)
  number String @db.VarChar(32)
  neighborhood String? @db.VarChar(120)
  crossStreetOne String? @db.VarChar(160)
  crossStreetTwo String? @db.VarChar(160)
  normalizedAddress String? @db.VarChar(500)
  latitude Decimal? @db.Decimal(9,6)
  longitude Decimal? @db.Decimal(9,6)
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@map("request_address")
}

model RequestMedia {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  kind RequestMediaKind
  physicalName String @unique @db.VarChar(180)
  detectedMime String @db.VarChar(120)
  bytes BigInt
  checksum String @db.VarChar(128)
  durationSeconds Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@index([requestId, kind])
  @@map("request_media")
}

model AccessAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  eventType String @db.VarChar(100)
  actorProfileId String? @db.Uuid
  subjectProfileId String? @db.Uuid
  outcome String @db.VarChar(30)
  correlationId String @db.VarChar(128)
  metadata Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([subjectProfileId, createdAt])
  @@map("access_audit_event")
}

model ServiceCategory {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  description String @db.VarChar(500)
  scopeDescription String @db.VarChar(1000)
  status CatalogPublicationStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  rates ServiceRate[]

  @@index([status])
  @@map("service_category")
}

model CoverageZone {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  status CoverageZoneStatus @default(INACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  rates ServiceRate[]

  @@index([status])
  @@map("coverage_zone")
}

model ServiceRate {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  zoneId String @db.Uuid
  currency String @db.Char(3)
  amount Decimal @db.Decimal(12, 2)
  validFrom DateTime @db.Timestamptz(3)
  validUntil DateTime? @db.Timestamptz(3)
  version Int
  status CatalogPublicationStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  zone CoverageZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@unique([categoryId, zoneId, version])
  @@index([categoryId, zoneId, status, validFrom])
  @@map("service_rate")
}
