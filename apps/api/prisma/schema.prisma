generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProcessingState {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ValidationState {
  RECEIVED
  VALID
  INVALID
}

enum MediaPocState {
  PENDING
  AVAILABLE
  REJECTED
  EXPIRED
  DELETED
}

enum ProfileRole {
  CLIENT
  DISPATCHER
  ADMIN
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
}

enum CatalogPublicationStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CoverageZoneStatus {
  ACTIVE
  INACTIVE
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  eventType String @db.VarChar(100)
  version Int
  aggregateType String? @db.VarChar(60)
  aggregateId String? @db.VarChar(100)
  payload Json?
  state ProcessingState @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([state, availableAt])
  @@map("outbox_event")
}

model ClaimedJob {
  id String @id @default(uuid()) @db.Uuid
  jobType String @db.VarChar(100)
  idempotencyKey String @db.VarChar(160)
  state ProcessingState @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  lastSafeError String? @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([jobType, idempotencyKey])
  @@index([state, availableAt])
  @@map("claimed_job")
}

model ProviderEventReceipt {
  id String @id @default(uuid()) @db.Uuid
  provider String @db.VarChar(60)
  externalEventIdHash String @db.VarChar(128)
  eventType String @db.VarChar(100)
  validationState ValidationState @default(RECEIVED)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  validatedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([provider, externalEventIdHash])
  @@index([validationState, receivedAt])
  @@map("provider_event_receipt")
}

model MediaPocObject {
  id String @id @default(uuid()) @db.Uuid
  physicalName String @unique @db.VarChar(180)
  detectedMime String @db.VarChar(120)
  bytes BigInt
  checksum String @db.VarChar(128)
  state MediaPocState @default(PENDING)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([state, expiresAt])
  @@map("media_poc_object")
}

model Profile {
  id String @id @default(uuid()) @db.Uuid
  identitySubject String @unique @db.VarChar(255)
  role ProfileRole
  status ProfileStatus @default(ACTIVE)
  displayName String? @db.VarChar(120)
  phone String? @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([role, status])
  @@map("profile")
}

model AccessAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  eventType String @db.VarChar(100)
  actorProfileId String? @db.Uuid
  subjectProfileId String? @db.Uuid
  outcome String @db.VarChar(30)
  correlationId String @db.VarChar(128)
  metadata Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([subjectProfileId, createdAt])
  @@map("access_audit_event")
}

model ServiceCategory {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  description String @db.VarChar(500)
  scopeDescription String @db.VarChar(1000)
  status CatalogPublicationStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  rates ServiceRate[]

  @@index([status])
  @@map("service_category")
}

model CoverageZone {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  status CoverageZoneStatus @default(INACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  rates ServiceRate[]

  @@index([status])
  @@map("coverage_zone")
}

model ServiceRate {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  zoneId String @db.Uuid
  currency String @db.Char(3)
  amount Decimal @db.Decimal(12, 2)
  validFrom DateTime @db.Timestamptz(3)
  validUntil DateTime? @db.Timestamptz(3)
  version Int
  status CatalogPublicationStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  zone CoverageZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@unique([categoryId, zoneId, version])
  @@index([categoryId, zoneId, status, validFrom])
  @@map("service_rate")
}
