# Copiar a .env solo para desarrollo local. Nunca versionar valores reales.
NODE_ENV=development
HOST=127.0.0.1
# API local; los portales usan siempre 3000 (cliente) y 3002 (administración).
PORT=3001
DATABASE_URL=
MEDIA_ROOT=./media
WORKER_POLL_INTERVAL_MS=30000
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_ADMIN_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_INTERNAL_CONNECTION=
PIGAR_CUSTOMER_AUTH0_DOMAIN=
PIGAR_CUSTOMER_AUTH0_CLIENT_ID=
PIGAR_CUSTOMER_AUTH0_CLIENT_SECRET=
PIGAR_CUSTOMER_AUTH0_APP_BASE_URL=http://localhost:3000
PIGAR_CUSTOMER_AUTH0_SESSION_SECRET=
# Opcional: si se omite, Cliente usa AUTH0_AUDIENCE compartida.
PIGAR_CUSTOMER_AUTH0_AUDIENCE=
PIGAR_CUSTOMER_AUTH0_EMAIL_OTP_CONNECTION=
# Sólo Compose integrado/smoke; nunca usar este origen para callbacks Auth0.
PIGAR_HTTP_BIND=127.0.0.1
PIGAR_HTTP_PORT=8088
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Backoffice Auth0: callback y logout locales sólo usan este origen.
APP_BASE_URL=http://localhost:3002
PIGAR_API_BASE_URL=http://127.0.0.1:3001/api
# Google Maps: navegador restringido por referrer y backend restringido por IP.
PIGAR_GOOGLE_BROWSER_KEY=
PIGAR_GOOGLE_GEOCODING_KEY=
